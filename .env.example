# Host paths and published ports used by Docker Compose.
VWC_DATA_ROOT=/srv/valheim-world-control
VWC_SERVER_ENV_FILE=/srv/valheim-world-control/control/server.env
VWC_CONTAINER_NAME=valheim-server
VWC_API_CONTAINER_NAME=valheim-world-control-api
VWC_AGENT_GID=1001
VALHEIM_PORT=2456
VALHEIM_QUERY_PORT=2457
SERVER_PORT=2456
SERVER_QUERY_PORT=2457
CONTROL_API_PORT=8443
CONTROL_AGENT_ENABLED=false

# Paths inside the API container. Keep certificates outside Git.
TLS_CERTIFICATE_FILE=/tls/server.crt
TLS_PRIVATE_KEY_FILE=/tls/server.key
