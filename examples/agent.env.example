VWC_DATA_ROOT=/srv/valheim-world-control
VWC_AGENT_SOCKET=/run/valheim-world-control/agent.sock
VWC_COMPOSE_DIRECTORY=/opt/valheim-world-control
VWC_CONTAINER_NAME=valheim-server
VWC_SERVER_NAME=My Valheim Server
VWC_ADVERTISED_ADDRESS=valheim.example.com:2456
VWC_SERVER_PORT=2456
VWC_SERVER_PUBLIC=false
VWC_WORLD_PASSWORD_DIRECTORY=/run/world-passwords
VWC_HEALTH_CHECK_SECONDS=180
